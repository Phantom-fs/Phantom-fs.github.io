---
const { biography } = Astro.props as {
  biography: { body: string; data: { summary: string; title: string } };
};

const paragraphs = biography.body.split(/\n{2,}/).filter(Boolean);
---

<section
  class="about-biography page-introduction"
  data-about-section="biography"
>
  <div class="frame page-introduction__content">
    <h1>{biography.data.title}</h1>
    <p class="type-body-lg">{biography.data.summary}</p>
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
