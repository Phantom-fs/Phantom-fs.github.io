---
const { label } = Astro.props as { label: string };

if (
  ![
    'Google Scholar',
    'ORCID',
    'GitHub',
    'LinkedIn',
    'ResearchGate',
    'DBLP'
  ].includes(label)
) {
  throw new Error(`Missing profile icon for ${label}`);
}
---

<svg
  aria-hidden="true"
  class="home-hero__profile-icon"
  data-profile-icon={label}
  fill="none"
  focusable="false"
  viewBox="0 0 24 24"
>
  {
    label === 'Google Scholar' && (
      <>
        <path d="m2.5 9.5 9.5-5 9.5 5-9.5 5-9.5-5Z" />
        <path d="M6.5 12v4.75L12 20l5.5-3.25V12" />
      </>
    )
  }
  {
    label === 'ORCID' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M9.25 10.25v5.5M9.25 8.25h.01M12.5 10.25v5.5M12.5 10.25h1.25a2.75 2.75 0 0 1 0 5.5H12.5" />
      </>
    )
  }
  {
    label === 'GitHub' && (
      <>
        <path d="m8.5 8.25-3.75 3.75 3.75 3.75M15.5 8.25l3.75 3.75-3.75 3.75" />
        <path d="M13.75 6.5 10.25 17.5" />
      </>
    )
  }
  {
    label === 'LinkedIn' && (
      <>
        <circle cx="7" cy="7" r="1.25" />
        <path d="M5.75 10.5v7.75M11.25 18.25V10.5M11.25 14.25a3.75 3.75 0 0 1 7.5 0v4" />
      </>
    )
  }
  {
    label === 'ResearchGate' && (
      <>
        <path d="M7.5 20.25h9M10 20.25v-3.5l4.25-4.25-1.75-1.75-4.25 4.25H5.5" />
        <path d="m14.25 9 1.5-1.5M6.5 12.5l-1.75-1.75 2.75-2.75 1.75 1.75" />
      </>
    )
  }
  {
    label === 'DBLP' && (
      <>
        <ellipse cx="12" cy="6.25" rx="6.5" ry="2.75" />
        <path d="M5.5 6.25v5.75c0 1.5 2.9 2.75 6.5 2.75s6.5-1.25 6.5-2.75V6.25M5.5 12v5.75c0 1.5 2.9 2.75 6.5 2.75s6.5-1.25 6.5-2.75V12" />
      </>
    )
  }
</svg>
