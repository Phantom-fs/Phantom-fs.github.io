---
import CloseIcon from '../shared/CloseIcon.astro';
---

<dialog
  class="publication-figure-dialog"
  id="publication-figure-dialog"
  aria-label="Publication figure"
  aria-describedby="publication-figure-caption"
  data-figure-dialog
>
  <figure>
    <div class="publication-figure-dialog__image">
      <button
        class="control icon-control dismiss-control publication-figure-dialog__close"
        type="button"
        aria-label="Close figure"
        data-figure-close><CloseIcon /></button
      >
      <div class="publication-figure-dialog__visual">
        <a
          class="control icon-control publication-figure-dialog__fullsize"
          data-figure-original
          data-astro-prefetch="false"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open full-size image in a new tab"
          title="Open full-size image"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"></path>
          </svg>
        </a>
        <img alt="" data-figure-image />
      </div>
    </div>
    <figcaption id="publication-figure-caption" data-figure-caption>
    </figcaption>
  </figure>
</dialog>
<script>
  import '../../lib/ui/publication-figure-dialog';
</script>
