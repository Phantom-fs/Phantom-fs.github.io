---
import ArtifactLinks from '../shared/ArtifactLinks.astro';
import PublicationMetadata from '../shared/PublicationMetadata.astro';
import SummaryDisclosure from '../shared/SummaryDisclosure.astro';
import type { CitationMetric as CitationMetricValue } from '../../lib/metrics/contract';
import type { CatalogPublication } from '../../lib/publications/catalog';

const { metric, publication } = Astro.props as {
  metric?: CitationMetricValue | null;
  publication: CatalogPublication;
};
const titleHref = publication.detailPage
  ? `/publications/${publication.slug}/`
  : publication.links?.paper;
const searchText = [
  publication.title,
  ...publication.authors.map(({ name }) => name),
  publication.venue,
  publication.year,
  publication.tldr,
  publication.abstract,
  publication.hashtags.join(' ')
]
  .join(' ')
  .toLocaleLowerCase();
---

<article
  class="publication-record"
  data-publication-record
  data-category={publication.primaryCategory}
  data-citations={metric?.value ?? ''}
  data-publication-id={publication.id}
  data-publication-search={searchText}
  data-title={publication.title}
>
  <div
    class:list={[
      'publication-record__overview',
      { 'publication-record__overview--illustrated': publication.figure }
    ]}
  >
    {
      publication.figure && (
        <a
          class="publication-figure"
          href={publication.figure.src}
          data-publication-figure
          data-figure-paper={publication.title}
          data-figure-caption={publication.figure.caption}
          data-figure-label={`${publication.figure.label} · page ${publication.figure.page}`}
          aria-label={`Enlarge ${publication.figure.label.toLowerCase()} for ${publication.title}`}
        >
          <img
            src={publication.figure.src.replace('.webp', '-640.webp')}
            srcset={`${publication.figure.src.replace('.webp', '-320.webp')} 320w, ${publication.figure.src.replace('.webp', '-640.webp')} 640w`}
            sizes="(max-width: 359px) calc(100vw - 6rem), (max-width: 639px) 112px, 224px"
            width={publication.figure.width}
            height={publication.figure.height}
            alt={publication.figure.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="publication-figure__label">
            View figure
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="10" cy="10" r="6.5" />
              <path d="m15 15 5 5M7 10h6m-3-3v6" />
            </svg>
          </span>
        </a>
      )
    }
    <div class="publication-record__summary">
      <PublicationMetadata
        authors={publication.authors.map(({ equalContribution, name }) =>
          equalContribution ? `${name}*` : name
        )}
        citationMetric={metric}
        rank={publication.rank}
        title={publication.title}
        titleHref={titleHref}
        transitionName={publication.detailPage
          ? `publication-${publication.id}`
          : undefined}
        venue={publication.venue}
      />
      <div class="publication-record__disclosures">
        <SummaryDisclosure label="TLDR">
          <p>{publication.tldr}</p>
        </SummaryDisclosure>
        <SummaryDisclosure label="Abstract">
          <p>{publication.abstract}</p>
        </SummaryDisclosure>
      </div>
    </div>
  </div>
  <div class="publication-record__taxonomy">
    <span class="type-metadata">Tags:</span>
    {
      publication.hashtags.map((hashtag) => (
        <button
          class="publication-hashtag"
          data-publication-hashtag={hashtag}
          type="button"
        >
          #{hashtag}
        </button>
      ))
    }
  </div>
  <ArtifactLinks
    links={publication.links}
    label={`Resources for ${publication.title}`}
  />
</article>
