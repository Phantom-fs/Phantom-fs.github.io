---
const { id = 'theme-toggle' } = Astro.props;
---

<button
  class="control icon-control theme-toggle"
  id={id}
  type="button"
  aria-label="Use dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="theme-toggle__moon"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
  >
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
  </svg>
  <svg
    class="theme-toggle__sun"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const storageKey = 'atlas-theme';

  const updateButton = (button: HTMLButtonElement) => {
    if (!button) return;
    const dark = root.dataset.theme === 'dark';
    button.setAttribute('aria-pressed', String(dark));
    button.setAttribute(
      'aria-label',
      dark ? 'Use light theme' : 'Use dark theme'
    );
  };

  const initializeThemeToggle = () => {
    const button = document.querySelector<HTMLButtonElement>(
      '[data-theme-toggle]'
    );

    if (!button) return;

    updateButton(button);
    if (button.dataset.themeToggleInitialized === 'true') return;

    button.dataset.themeToggleInitialized = 'true';
    button.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nextTheme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', nextTheme === 'dark' ? '#202325' : '#FAFAF8');
      try {
        localStorage.setItem(storageKey, nextTheme);
      } catch {
        // The selected theme remains available for the current page session.
      }
      updateButton(button);
    });
  };

  const lifecycleHost = window as typeof window & {
    atlasThemeToggleLifecycle?: AbortController;
  };
  lifecycleHost.atlasThemeToggleLifecycle?.abort();
  const lifecycle = new AbortController();
  lifecycleHost.atlasThemeToggleLifecycle = lifecycle;

  initializeThemeToggle();
  document.addEventListener('astro:after-swap', initializeThemeToggle, {
    signal: lifecycle.signal
  });
</script>
