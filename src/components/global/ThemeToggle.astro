---
const { id = 'theme-toggle' } = Astro.props;
---

<button
  class="control icon-control theme-toggle"
  id={id}
  type="button"
  aria-label="Use dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg
    class="theme-toggle__moon"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
  >
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
  </svg>
  <svg
    class="theme-toggle__sun"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  import '../../lib/ui/theme-toggle';
</script>
