---
import { publicEmail, socialLinks } from '../../lib/ui/site';
import { resolve } from 'node:path';
import { loadValidatedContent } from '../../lib/content/query';
import ExternalLinkIcon from '../shared/ExternalLinkIcon.astro';

const footer = (await loadValidatedContent(resolve('src/content'))).site.find(
  ({ data }) => data.id === 'footer'
);
if (!footer) throw new Error('Required site content is missing: footer');

const { currentPath = '' } = Astro.props as { currentPath?: string };
const isOverview = currentPath === '/overview/' || currentPath === '/overview';
---

<footer class="site-footer">
  <div class="frame site-footer__grid">
    <div class="site-footer__identity">
      <p class="type-label">{footer.data.title}</p>
      <a
        class="site-footer__contact link-underlined"
        href={`mailto:${publicEmail}?subject=Research%20conversation`}
      >
        <span class="site-footer__contact-label">Get in touch</span>
        <span class="site-footer__contact-email">{publicEmail}</span>
      </a>
    </div>
    <nav class="site-footer__links type-body-sm" aria-label="Research profiles">
      {
        socialLinks.map(({ href, label }) => (
          <a
            class="link-underlined"
            href={href}
            rel="me noopener noreferrer"
            target="_blank"
          >
            {label}
            <ExternalLinkIcon />
          </a>
        ))
      }
    </nav>
    {
      isOverview && (
        <a
          class="action action--secondary site-footer__return"
          data-overview-return
          aria-label="Return to full site"
          href="/"
        >
          Return to full site
          <ExternalLinkIcon />
        </a>
      )
    }
  </div>
  <p class="frame site-footer__copyright">{footer.body}</p>
</footer>
