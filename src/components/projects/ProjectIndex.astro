---
import ProjectCaseStudy from './ProjectCaseStudy.astro';
import DomainRelationshipIndex from '../shared/DomainRelationshipIndex.astro';

const { introduction, projects, publications } = Astro.props as {
  introduction: { body: string; data: { summary: string; title: string } };
  projects: {
    body: string;
    data: {
      associatedPublicationIds: string[];
      contribution: string;
      datasetScale: string[];
      methodology: string[];
      outcomes: string[];
      problem: string;
      role: string;
      slug: string;
      summary: string;
      technology: string[];
      title: string;
    };
  }[];
  publications: Map<string, { slug: string; title: string }>;
};
---

<section
  class="projects-introduction page-introduction"
  data-projects-section="introduction"
>
  <div class="frame page-introduction__content">
    <h1>{introduction.data.title}</h1>
    <p class="type-body-lg">{introduction.data.summary}</p>
    <p>{introduction.body}</p>
  </div>
</section>
<section
  class="projects-case-studies research-chapter section-band-evidence"
  data-projects-section="case-studies"
  data-chapter="projects"
  data-chapter-path="/projects/"
>
  <div class="frame research-composition research-chapter__grid">
    <aside class="research-chapter__atlas">
      <DomainRelationshipIndex
        compact
        currentDomain={projects[0]?.data.slug ?? ''}
        domains={projects.map(({ data }) => ({
          category: data.title,
          slug: data.slug,
          summary: data.summary,
          title: data.title
        }))}
        id="project-index"
        route="projects"
      />
    </aside>
    <div class="research-chapter__domains">
      {
        projects.map((project) => (
          <ProjectCaseStudy project={project} publications={publications} />
        ))
      }
    </div>
  </div>
</section>
<script>
  import '../../lib/ui/chapter-tabs';
</script>
